---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale) as any;
const f = t.footer;
const isEn = locale === 'en';

const bookHref = locale === 'en' ? '/book' : '/es/book';
const contactHref = locale === 'en' ? '/contact' : '/es/contact';
const privacyHref = locale === 'en' ? '/privacy-policy' : '/es/privacy-policy';
const cookiesHref = locale === 'en' ? '/cookie-policy' : '/es/cookie-policy';
const blogHref = locale === 'en' ? '/blog' : '/es/blog';
const servicesHref = locale === 'en' ? '/services' : '/es/services';
const pricingHref = locale === 'en' ? '/pricing' : '/es/pricing';
const faqHref = locale === 'en' ? '/faq' : '/es/faq';
---

<footer id="contact" class="bg-[#050505] text-[#f7f9fc] border-t-4 border-[#00E5FF]">
  <div class="mx-auto max-w-7xl px-6">

    <!-- ──────────────── Top: Brand + 3-column links ──────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 py-20">
      <!-- Brand column -->
      <div>
        <div class="text-2xl font-display font-bold mb-3">
          Horizon <span class="text-[#00E5FF] font-['Caveat'] text-3xl ml-1">-gh</span>
        </div>
        <p class="text-xs text-[#6b7280] uppercase tracking-widest mb-4">{f.brand_tagline}</p>
        <p class="text-sm text-[#9ca3af] leading-relaxed max-w-xs">{f.brand_desc}</p>
      </div>

      <!-- Services links -->
      <div>
        <p class="text-xs text-[#6b7280] font-bold tracking-widest mb-5 uppercase">{f.col_services}</p>
        <ul class="space-y-3 text-sm text-[#9ca3af]">
          <li><a href={servicesHref} class="hover:text-[#00E5FF] transition-colors">{f.link_software}</a></li>
          <li><a href={servicesHref} class="hover:text-[#00E5FF] transition-colors">{f.link_web}</a></li>
          <li><a href={servicesHref} class="hover:text-[#00E5FF] transition-colors">{f.link_digital}</a></li>
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <p class="text-xs text-[#6b7280] font-bold tracking-widest mb-5 uppercase">{f.col_company}</p>
        <ul class="space-y-3 text-sm text-[#9ca3af]">
          <li><a href="/" class="hover:text-[#00E5FF] transition-colors">{f.link_about}</a></li>
          <li><a href="/" class="hover:text-[#00E5FF] transition-colors">{f.link_work}</a></li>
          <li><a href={pricingHref} class="hover:text-[#00E5FF] transition-colors">{f.link_pricing}</a></li>
          <li><a href={bookHref} class="hover:text-[#00E5FF] transition-colors">{f.link_book}</a></li>
        </ul>
      </div>

      <!-- Resources links -->
      <div>
        <p class="text-xs text-[#6b7280] font-bold uppercase tracking-widest mb-5">{f.col_resources}</p>
        <ul class="space-y-3 text-sm text-[#9ca3af]">
          <li><a href={blogHref} class="hover:text-[#00E5FF] transition-colors">{f.link_blog}</a></li>
          <li><a href={faqHref} class="hover:text-[#00E5FF] transition-colors">{f.link_faq}</a></li>
          <li><a href={contactHref} class="hover:text-[#00E5FF] transition-colors">{f.link_contact}</a></li>
        </ul>
      </div>
    </div>

    <!-- ──────────────── Divider ──────────────── -->
    <div class="border-t border-[#1f2937]"></div>

    <!-- ──────────────── CTA section ──────────────── -->
    <div class="py-12">
      <h2 class="text-xl sm:text-2xl font-display font-bold mb-6 text-center">
        {f.cta_heading}
      </h2>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={bookHref}
          class="rounded-full bg-[#00E5FF] px-6 py-3 text-sm font-bold text-black transition-all hover:shadow-[0_0_24px_rgba(0,229,255,0.55)] inline-flex items-center gap-2"
        >
          {f.cta_button}
        </a>
        <span class="text-sm text-[#6b7280]">{f.cta_or}</span>
        <a
          href={contactHref}
          class="text-sm text-[#9ca3af] hover:text-[#00E5FF] transition-colors"
        >
          {f.cta_contact}
        </a>
      </div>
    </div>

    <!-- ──────────────── Divider ──────────────── -->
    <div class="border-t border-[#1f2937]"></div>

    <!-- ──────────────── Bottom bar: legal links + social + copyright ──────────────── -->
    <div class="py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <!-- Legal links -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-[#6b7280]">
        <a href={privacyHref} class="hover:text-[#00E5FF] transition-colors">{f.legal_privacy}</a>
        <span aria-hidden="true" class="text-[#374151]">·</span>
        <a href={cookiesHref} class="hover:text-[#00E5FF] transition-colors">{f.legal_cookies}</a>
        <span aria-hidden="true" class="text-[#374151]">·</span>
        <span class="cursor-default">{f.legal_terms}</span>
        <span aria-hidden="true" class="text-[#374151]">·</span>
        <span class="cursor-default">{f.legal_legal}</span>
        <span aria-hidden="true" class="text-[#374151]">·</span>
        <button type="button" data-action="open-cookie-settings" class="hover:text-[#00E5FF] transition-colors cursor-pointer">{f.legal_settings}</button>
      </div>

      <!-- Social + copyright -->
      <div class="flex items-center gap-6">
        <!-- Social icons -->
        <a href="https://github.com/HorizonGH" target="_blank" class="text-[#6b7280] hover:text-[#00E5FF] transition-colors" aria-label={isEn ? 'GitHub' : 'GitHub'}>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://www.instagram.com/_horizon.gh" target="_blank" class="text-[#6b7280] hover:text-[#00E5FF] transition-colors" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <p class="text-xs text-[#6b7280]">
          &copy; {new Date().getFullYear()} Horizon. {f.rights}
        </p>
      </div>
    </div>
  </div>
</footer>