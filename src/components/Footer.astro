---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale) as any;

const NAV = [
  { href: locale === 'en' ? '/' : '/es/', label: t.nav.home },
  { href: locale === 'en' ? '/services' : '/es/services', label: t.nav.services },
  { href: locale === 'en' ? '/blog' : '/es/blog', label: t.nav.blog },
  { href: locale === 'en' ? '/contact' : '/es/contact', label: t.nav.contact },
];

const isEn = locale === 'en';
const exploreLabel = isEn ? 'Explore' : 'Explorar';
---

<footer id="contact" class="bg-black text-white py-20 border-t-4 border-[#00E5FF]">
  <div class="shell mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <!-- Contact Form -->
      <div>
        <h2 class="text-3xl font-display font-bold mb-8">
          {isEn ? 'Start a Conversation' : t.contact.title}
        </h2>
        <form method="post" action="/api/contact" class="space-y-6">
          <input type="hidden" name="locale" value={locale} />
          <div>
            <label for="name" class="label-sm block text-gray-400 mb-2">
              {isEn ? 'Name' : t.home_page.form_name}
            </label>
            <input
              name="name"
              type="text"
              id="name"
              required
              class="w-full bg-gray-900 border border-gray-800 text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#00E5FF] transition-colors"
              placeholder={isEn ? 'John Doe' : t.home_page.form_name_placeholder}
            />
          </div>
          <div>
            <label for="email" class="label-sm block text-gray-400 mb-2">
              {isEn ? 'Email' : t.home_page.form_email}
            </label>
            <input
              name="email"
              type="email"
              id="email"
              required
              class="w-full bg-gray-900 border border-gray-800 text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#00E5FF] transition-colors"
              placeholder={isEn ? 'john@example.com' : t.home_page.form_email_placeholder}
            />
          </div>
          <div>
            <label for="topic" class="label-sm block text-gray-400 mb-2">
              {isEn ? 'Topic' : 'Tema'}
            </label>
            <input
              name="topic"
              type="text"
              id="topic"
              required
              class="w-full bg-gray-900 border border-gray-800 text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#00E5FF] transition-colors"
              placeholder={isEn ? 'What would you like to discuss?' : '¿Sobre qué te gustaría hablar?'}
            />
          </div>
          <div>
            <label for="message" class="label-sm block text-gray-400 mb-2">
              {isEn ? 'Message' : t.home_page.form_message}
            </label>
            <textarea
              name="message"
              id="message"
              rows="4"
              required
              class="w-full bg-gray-900 border border-gray-800 text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#00E5FF] transition-colors"
              placeholder={isEn ? 'Tell us about your project...' : t.home_page.form_message_placeholder}
            ></textarea>
          </div>
          <button
            type="submit"
            class="bg-[#00E5FF] text-black font-bold py-3 px-8 rounded-lg hover:bg-cyan-400 transition-colors w-full md:w-auto"
          >
            {isEn ? 'Send Message' : t.contact.submit}
          </button>
        </form>
      </div>

      <!-- Footer Information -->
      <div class="flex flex-col justify-between">
        <div>
          <div class="text-3xl font-display font-bold mb-6">
            Horizon <span class="text-[#00E5FF] font-['Caveat'] text-4xl ml-1">-gh</span>
          </div>
          <p class="text-gray-400 mb-8 max-w-sm">
            {isEn
              ? 'Engineering the next generation of web applications from the heart of America to the world.'
              : t.home_page.footer_description}
          </p>

          <div class="space-y-4 text-sm text-gray-400">
            <p class="flex items-center">
              <svg class="w-5 h-5 mr-3 text-[#00E5FF] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              America
            </p>
            <p class="flex items-center">
              <svg class="w-5 h-5 mr-3 text-[#00E5FF] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              contact@horizon-gh.com
            </p>
          </div>
        </div>

        <div class="mt-12 md:mt-0">
          <!-- Footer Nav Menu -->
          <nav aria-label="Footer" class="mb-8">
            <h3 class="font-display font-bold text-white mb-4">{exploreLabel}</h3>
            <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-gray-400">
              {NAV.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex items-center gap-1.5 transition-colors hover:text-[#00E5FF]">
                    <span class="text-[#00E5FF]" aria-hidden="true">&#10003;</span>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-t border-gray-800 pt-8">
            <!-- Social Links -->
            <div class="flex space-x-4 mb-6 md:mb-0">
              <a href="https://github.com/HorizonGH" target="_blank" class="text-gray-400 hover:text-[#00E5FF] transition-colors p-2 bg-gray-900 rounded-full">
                <span class="sr-only">{isEn ? 'GitHub' : t.home_page.social_github}</span>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
              <a href="https://www.instagram.com/_horizon.gh" target="_blank" class="text-gray-400 hover:text-[#00E5FF] transition-colors p-2 bg-gray-900 rounded-full">
                <span class="sr-only">{isEn ? 'Instagram' : t.home_page.social_instagram}</span>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
            <p class="text-sm text-gray-500">
              &copy; {new Date().getFullYear()} Horizon gh. {isEn ? 'All rights reserved.' : t.home_page.footer_rights}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
