---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const cc = t.cookie_consent;
---

<!-- ───────────────────────────────────────────────────────
     COOKIE CONSENT BANNER
     Shows on first visit unless consent already stored.
     ─────────────────────────────────────────────────────── -->
<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[9998] hidden border-t border-outline-variant bg-surface-container-low"
  role="dialog"
  aria-label={cc.banner_title}
  aria-modal="false"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-4 sm:py-5">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 sm:gap-6">

      <!-- Left: title + text + policy links -->
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-sm sm:text-base text-on-surface mb-1.5">
          {cc.banner_title}
        </p>
        <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-2 max-w-prose">
          {cc.banner_text}
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-on-surface-variant">
          <a href={locale === 'en' ? '/privacy-policy' : '/es/privacy-policy'} class="underline hover:text-accent-cyan transition-colors">
            {locale === 'en' ? 'Privacy Policy' : 'Política de Privacidad'}
          </a>
          <span aria-hidden="true">·</span>
          <a href={locale === 'en' ? '/cookie-policy' : '/es/cookie-policy'} class="underline hover:text-accent-cyan transition-colors">
            {locale === 'en' ? 'Cookie Policy' : 'Política de Cookies'}
          </a>
        </div>
      </div>

      <!-- Right column: action buttons -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 shrink-0">
        <button
          id="cookie-btn-reject"
          class="rounded-full border border-outline-variant px-4 py-2 text-xs sm:text-sm font-medium text-on-surface-variant hover:bg-surface-container-high transition-colors"
        >
          {cc.btn_reject}
        </button>
        <button
          id="cookie-btn-manage"
          class="rounded-full border border-outline-variant px-4 py-2 text-xs sm:text-sm font-medium text-on-surface-variant hover:bg-surface-container-high transition-colors"
        >
          {cc.btn_manage}
        </button>
        <button
          id="cookie-btn-accept"
          class="rounded-full bg-accent-cyan px-5 py-2 text-xs sm:text-sm font-bold text-black transition-all hover:shadow-[0_0_20px_rgba(76,214,251,0.45)]"
        >
          {cc.btn_accept}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ───────────────────────────────────────────────────────
     COOKIE SETTINGS PANEL (overlay modal)
     ─────────────────────────────────────────────────────── -->
<div
  id="cookie-settings-overlay"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-label={cc.settings_title}
  aria-modal="true"
>
  <div class="bg-surface-container rounded-2xl border border-outline-variant w-full max-w-lg shadow-2xl overflow-hidden">
    <!-- Header -->
    <div class="px-5 sm:px-6 py-4 sm:py-5 border-b border-outline-variant">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-bold text-on-surface">{cc.settings_title}</h2>
        <button
          id="cookie-settings-close"
          class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container-high transition-colors text-on-surface-variant"
          aria-label="Close"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed">
        {cc.settings_desc}
      </p>
    </div>

    <!-- Categories list -->
    <div class="p-5 sm:p-6 space-y-5 max-h-[50vh] overflow-y-auto">

      <!-- Necessary (always on) -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-on-surface">{cc.cat_necessary}</p>
          <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">{cc.cat_necessary_desc}</p>
        </div>
        <span class="text-xs font-medium text-accent-cyan bg-accent-cyan/10 px-2.5 py-1 rounded-full shrink-0">
          {cc.cat_always_active}
        </span>
      </div>

      <!-- Analytics -->
      <div class="flex items-start justify-between gap-4 pt-3 border-t border-outline-variant">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-on-surface">{cc.cat_analytics}</p>
          <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">{cc.cat_analytics_desc}</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
          <input
            type="checkbox"
            id="cookie-toggle-analytics"
            class="peer sr-only"
          />
          <div class="w-10 h-5 rounded-full bg-surface-container-high peer-checked:bg-accent-cyan transition-colors duration-200 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform after:duration-200 peer-checked:after:translate-x-full"></div>
        </label>
      </div>

      <!-- Advertising -->
      <div class="flex items-start justify-between pt-3 border-t border-outline-variant">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-on-surface">{cc.cat_advertising}</p>
          <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">{cc.cat_advertising_desc}</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
          <input
            type="checkbox"
            id="cookie-toggle-advertising"
            class="peer sr-only"
          />
          <div class="w-10 h-5 rounded-full bg-surface-container-high peer-checked:bg-accent-cyan transition-colors duration-200 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform after:duration-200 peer-checked:after:translate-x-full"></div>
        </label>
      </div>

      <!-- Functional -->
      <div class="flex items-start justify-between pt-3 border-t border-outline-variant">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-on-surface">{cc.cat_functional}</p>
          <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">{cc.cat_functional_desc}</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
          <input
            type="checkbox"
            id="cookie-toggle-functional"
            class="peer sr-only"
          />
          <div class="w-10 h-5 rounded-full bg-surface-container-high peer-checked:bg-accent-cyan transition-colors duration-200 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform after:duration-200 peer-checked:after:translate-x-full"></div>
        </label>
      </div>
    </div>

    <!-- Footer actions -->
    <div class="px-5 sm:px-6 py-4 border-t border-outline-variant flex items-center gap-3">
      <button
        id="cookie-settings-save"
        class="flex-1 rounded-full bg-accent-cyan px-5 py-2.5 text-sm font-bold text-white transition-all hover:shadow-[0_0_20px_rgba(0,0,0,0.45)] w-full"
      >
        {cc.btn_save}
      </button>
    </div>
  </div>
</div>

<script>
  // ═════════════════════════════════════════════════════════
  // Cookie Consent Manager
  // ═════════════════════════════════════════════════════════

  const STORAGE_KEY = 'horizon_cookie_consent';

  interface ConsentState {
    analytics: boolean;
    advertising: boolean;
    functional: boolean;
    accepted: boolean;   // true = user has made a choice
  }

  function getStoredConsent(): ConsentState | null {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (_) {
      return null;
    }
  }

  function storeConsent(state: ConsentState): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (_) {}
  }

  function applyConsent(state: ConsentState): void {
    document.documentElement.setAttribute('data-cookie-analytics', state.analytics ? '1' : '0');
    document.documentElement.setAttribute('data-cookie-advertising', state.advertising ? '1' : '0');
    document.documentElement.setAttribute('data-cookie-functional', state.functional ? '1' : '0');
    document.documentElement.setAttribute('data-cookie-choice', '1');
  }

  let currentConsent: ConsentState;
  var stored = getStoredConsent();
  if (stored && stored.accepted) {
    currentConsent = stored;
    applyConsent(stored);
  } else {
    currentConsent = { analytics: false, advertising: false, functional: false, accepted: false };
    document.documentElement.setAttribute('data-cookie-choice', '0');
  }

  // DOM references
  var banner = document.getElementById('cookie-banner')!;
  var overlay = document.getElementById('cookie-settings-overlay')!;

  var toggleAnalytics = document.getElementById('cookie-toggle-analytics') as HTMLInputElement | null;
  var toggleAdvertising = document.getElementById('cookie-toggle-advertising') as HTMLInputElement | null;
  var toggleFunctional = document.getElementById('cookie-toggle-functional') as HTMLInputElement | null;

  // ── Show banner if no decision yet ──
  function showBannerIfNeeded(): void {
    if (!banner) return;
    var stored = getStoredConsent();
    if (!stored || !stored.accepted) {
      banner.classList.remove('hidden');
    }
  }

  showBannerIfNeeded();

  // ── Accept all ──
  document.getElementById('cookie-btn-accept')?.addEventListener('click', function () {
    var state: ConsentState = { analytics: true, advertising: true, functional: true, accepted: true };
    storeConsent(state);
    applyConsent(state);
    currentConsent = state;
    banner?.classList.add('hidden');
  });

  // ── Reject non-essential ──
  document.getElementById('cookie-btn-reject')?.addEventListener('click', function () {
    var state: ConsentState = { analytics: false, advertising: false, functional: false, accepted: true };
    storeConsent(state);
    applyConsent(state);
    currentConsent = state;
    banner?.classList.add('hidden');
  });

  // ── Open manage panel ──
  function openSettingsPanel(): void {
    if (!overlay || !toggleAnalytics || !toggleAdvertising || !toggleFunctional) return;
    toggleAnalytics.checked = currentConsent.analytics;
    toggleAdvertising.checked = currentConsent.advertising;
    toggleFunctional.checked = currentConsent.functional;
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
  }

  document.getElementById('cookie-btn-manage')?.addEventListener('click', function () {
    openSettingsPanel();
  });

  // ── Save preferences from panel ──
  document.getElementById('cookie-settings-save')?.addEventListener('click', function () {
    var state: ConsentState = {
      analytics: toggleAnalytics?.checked ?? false,
      advertising: toggleAdvertising?.checked ?? false,
      functional: toggleFunctional?.checked ?? false,
      accepted: true,
    };
    storeConsent(state);
    applyConsent(state);
    currentConsent = state;
    banner?.classList.add('hidden');
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
  });

  // ── Close panel ──
  document.getElementById('cookie-settings-close')?.addEventListener('click', function () {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
  });

  // Click outside to close
  overlay?.addEventListener('click', function (e) {
    if (e.target === overlay) {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }
  });

  // ── External API: open settings from any link/button ──
  // Elements with data-action="open-cookie-settings" trigger the panel
  document.addEventListener('click', function (e: Event) {
    var target = e.target as HTMLElement;
    var trigger = target.closest('[data-action="open-cookie-settings"]');
    if (trigger) {
      e.preventDefault();
      openSettingsPanel();
    }
  });
</script>