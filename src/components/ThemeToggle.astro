---
interface Props {
  locale?: 'en' | 'es';
  class?: string;
}

const { locale = 'en', class: className = '' } = Astro.props;
const label = locale === 'en' ? 'Toggle dark mode' : 'Cambiar a modo oscuro';
---

<button
  data-theme-toggle
  type="button"
  aria-label={label}
  title={label}
  class:list={[
    'inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-surface-container-low text-on-surface transition-colors hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)] md:border-gray-300 md:bg-transparent md:text-gray-900',
    className,
  ]}
>
  <!-- Moon icon: visible in light mode, click to switch to dark -->
  <svg class="theme-icon theme-icon-moon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
  </svg>
  <!-- Sun icon: visible in dark mode -->
  <svg class="theme-icon theme-icon-sun w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
</button>

<style>
  .theme-icon {
    pointer-events: none;
    flex: none;
  }
  .theme-icon-moon {
    display: block;
  }
  .theme-icon-sun {
    display: none;
  }
  :global(.dark) [data-theme-toggle] {
    color: var(--color-on-surface);
  }
  :global(.dark) .theme-icon-moon {
    display: none;
  }
  :global(.dark) .theme-icon-sun {
    display: block;
  }
</style>

<script>
  const KEY = 'theme';

  function isDark() {
    return document.documentElement.classList.contains('dark');
  }

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    try {
      localStorage.setItem(KEY, dark ? 'dark' : 'light');
    } catch (e) {}
  }

  // Brief transition so the palette change feels smooth
  function withTransition(fn: () => void) {
    document.documentElement.classList.add('theme-switching');
    fn();
    window.setTimeout(
      () => document.documentElement.classList.remove('theme-switching'),
      300
    );
  }

  function setup() {
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement) || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        withTransition(() => applyTheme(!isDark()));
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
