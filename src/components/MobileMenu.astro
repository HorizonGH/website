---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pathname = Astro.url.pathname;

// Build locale-aware URLs for language switching
const cleanPath = pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enURL = cleanPath;
const esURL = '/es' + (cleanPath === '/' ? '' : cleanPath);

const NAV = [
  { to: locale === 'en' ? '/' : '/es/', label: t.nav.home },
  { to: locale === 'en' ? '/services' : '/es/services', label: t.nav.services },
  { to: locale === 'en' ? '/pricing' : '/es/pricing', label: t.nav.pricing },
  { to: locale === 'en' ? '/blog' : '/es/blog', label: t.nav.blog },
  { to: locale === 'en' ? '/contact' : '/es/contact', label: t.nav.contact },
];

const contactHref = locale === 'en' ? '/contact' : '/es/contact';
const ctaLabel = locale === 'en' ? 'Start a project' : 'Comenzar un proyecto';

const isActive = (to: string) => {
  if (to.endsWith('/')) return pathname === to;
  return pathname === to || pathname.startsWith(to + '/');
};
---

<div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col">
    {NAV.map((item) => (
      <a
        href={item.to}
        class={`border-b border-gray-200 py-4 text-lg font-semibold transition-colors last:border-0 ${
          isActive(item.to) ? 'text-cyan-600' : 'text-gray-900 hover:text-cyan-600'
        }`}
      >
        {item.label}
      </a>
    ))}

    <!-- Language switcher for mobile -->
    <div class="flex items-center justify-between py-4 border-b border-gray-200">
      <span class="text-sm text-gray-500 font-medium uppercase tracking-wider">
        {locale === 'en' ? 'Language' : 'Idioma'}
      </span>
      <div class="flex items-center gap-2">
        <a
          href={enURL}
          class={`px-4 py-1.5 rounded-full border text-sm font-medium transition-colors ${
            locale === 'en'
              ? 'bg-[var(--color-accent-cyan)] text-black border-transparent'
              : 'border-gray-300 text-gray-600 hover:text-gray-900'
          }`}
        >
          EN
        </a>
        <a
          href={esURL}
          class={`px-4 py-1.5 rounded-full border text-sm font-medium transition-colors ${
            locale === 'es'
              ? 'bg-[var(--color-accent-cyan)] text-black border-transparent'
              : 'border-gray-300 text-gray-600 hover:text-gray-900'
          }`}
        >
          ES
        </a>
        <ThemeToggle locale={locale} class="w-11 h-11 shrink-0" />
      </div>
    </div>

    <a
      href={contactHref}
      class="my-4 rounded-full bg-[var(--color-accent-cyan)] px-5 py-3 text-center text-sm font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
    >
      {ctaLabel}
    </a>
  </div>
</div>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuLinks = mobileMenu?.querySelectorAll('a');

  function setMenuOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.classList.toggle('hidden', !open);
    const icon = menuToggle.querySelector('.material-symbols-outlined');
    if (icon) icon.textContent = open ? 'close' : 'menu';
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      setMenuOpen(mobileMenu.classList.contains('hidden'));
    });

    // Close menu when clicking on a link
    menuLinks?.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
      });
    });
  }
</script>
