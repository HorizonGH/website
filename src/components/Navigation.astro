---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Logo from '../components/Logo.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

const pathname = Astro.url.pathname;

const NAV = [
  { to: locale === 'en' ? '/' : '/es/', label: t.nav.home },
  { to: locale === 'en' ? '/services' : '/es/services', label: t.nav.services },
  { to: locale === 'en' ? '/pricing' : '/es/pricing', label: t.nav.pricing },
  { to: locale === 'en' ? '/book' : '/es/book', label: t.nav.book },
  { to: locale === 'en' ? '/blog' : '/es/blog', label: t.nav.blog },
  { to: locale === 'en' ? '/contact' : '/es/contact', label: t.nav.contact },
];

const contactHref = locale === 'en' ? '/contact' : '/es/contact';
const ctaLabel = locale === 'en' ? 'Start a project' : 'Comenzar un proyecto';

const isActive = (to: string) => {
  if (to.endsWith('/')) return pathname === to;
  return pathname === to || pathname.startsWith(to + '/');
};
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/80 backdrop-blur-xl">
  <div class="flex items-center justify-between max-w-7xl mx-auto px-4 sm:px-6 py-3 sm:py-4">
    <a href={NAV[0].to} class="group flex items-baseline gap-1" aria-label="Horizon gh Home">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {NAV.map((item) => (
        <a
          key={item.to}
          href={item.to}
          class={`text-sm font-medium transition-colors ${
            isActive(item.to) ? 'text-gray-900' : 'text-gray-600 hover:text-gray-900'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden md:block">
        <LanguageSwitcher currentUrl={Astro.url} />
      </div>
      <div class="hidden md:block">
        <ThemeToggle locale={locale} />
      </div>
      <a
        href={contactHref}
        class="hidden rounded-full bg-[var(--color-accent-cyan)] px-5 py-2.5 text-sm font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)] md:inline-flex"
      >
        {ctaLabel}
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
        class="inline-flex w-10 h-10 items-center justify-center rounded-full border border-gray-300 md:hidden text-gray-900"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <MobileMenu locale={locale} />
</header>
