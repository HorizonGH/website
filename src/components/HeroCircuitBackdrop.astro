  <div id="ripple-layer" class="pointer-events-none absolute inset-0 overflow-hidden"></div>
</div>

<style>
  .trace {
    stroke: #475569;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: visibleStroke;
    cursor: crosshair;
  }
  .trace-pulse {
    stroke: #25e0e6;
    pointer-events: none;
    filter: blur(2px) drop-shadow(0 0 8px #25e0e6) drop-shadow(0 0 14px rgba(37, 224, 230, 0.7));
  }
  .node {
    fill: #f8fafc;
    stroke: #475569;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px rgba(15, 23, 42, 0.15));
    transition: fill 200ms ease, stroke 200ms ease, filter 200ms ease;
    animation: nodePulse 2.5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
  }
  .circuit-trace-group:hover .node {
    fill: rgba(37, 224, 230, 0.85);
    stroke: #25e0e6;
    filter: drop-shadow(0 0 10px rgba(37, 224, 230, 0.6));
  }
  .circuit-ripple {
    position: absolute;
    width: 100px;
    height: 100px;
    margin-left: -50px;
    margin-top: -50px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(37,224,230,0.5) 0%, rgba(37,224,230,0.1) 40%, transparent 70%);
    pointer-events: none;
    animation: rippleBurst 0.55s ease-out forwards;
  }
  @keyframes nodePulse {
    0%, 100% { opacity: 0.78; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1.08); }
  }
  @keyframes rippleBurst {
    0% {
      transform: scale(0);
      opacity: 0.7;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace-pulse, .node { animation: none !important; }
    .trace-pulse > animate { display: none; }
    .circuit-ripple { display: none; }
  }
</style>

<script>
  (function () {
    const rippleLayer = document.getElementById('ripple-layer');
    if (!rippleLayer) return;

    const section = rippleLayer.closest('section') || rippleLayer.parentElement?.closest('[class*="relative"]');
    if (!section) return;

    function createRipple(e) {
      const trace = e.currentTarget;
      const rect = section.getBoundingClientRect();
      const x = e.clientX - rect.left + section.scrollLeft;
      const y = e.clientY - rect.top + section.scrollTop;

      const ripple = document.createElement('div');
      ripple.className = 'circuit-ripple';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';
      rippleLayer.appendChild(ripple);

      ripple.addEventListener('animationend', function () {
        ripple.remove();
      }, { once: true });
    }

    document.querySelectorAll('.trace').forEach(function (el) {
      el.addEventListener('click', createRipple);
    });
  })();
</script>
