      <circle cx="110" cy="108" r="3" class="node" />
      <circle cx="140" cy="126" r="2.5" class="node" />
      <circle cx="80" cy="170" r="3.5" class="node" />
      <circle cx="50" cy="240" r="3" class="node" />
      <circle cx="95" cy="340" r="4" class="node" />
      <circle cx="110" cy="355" r="3" class="node" />
