  <!-- Right circuits -->
  <svg class="absolute right-0 top-0 h-full w-[90px] sm:w-[150px] md:w-[30vw] lg:w-[420px] z-0" viewBox="0 0 280 540" preserveAspectRatio="xMidYMid meet" fill="none">
    <g class="circuit-trace-group">
      <path d="M 300 60 L 200 60 L 170 90 L 70 90" class="trace" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M 300 60 L 200 60 L 170 90 L 70 90" class="trace-pulse" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="12 88" stroke-dashoffset="100" opacity="0">
