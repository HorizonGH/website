        <animate attributeName="opacity" values="0;0;0.9;0.9;0" keyTimes="0;0.15;0.4;0.7;1" dur="2.5s" begin="0.15s" repeatCount="indefinite" />
      </path>

      <path d="M 300 78 L 205 78 L 175 108 L 110 108" class="trace" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
      <path d="M 300 78 L 205 78 L 175 108 L 110 108" class="trace-pulse" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="10 90" stroke-dashoffset="100" opacity="0">
        <animate attributeName="stroke-dashoffset" from="100" to="0" dur="2.2s" begin="0.55s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0;0;0.85;0.85;0" keyTimes="0;0.15;0.4;0.7;1" dur="2.2s" begin="0.55s" repeatCount="indefinite" />
      </path>

      <path d="M 300 96 L 210 96 L 180 126 L 140 126" class="trace" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />
      <path d="M 300 96 L 210 96 L 180 126 L 140 126" class="trace-pulse" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="8 92" stroke-dashoffset="100" opacity="0">
        <animate attributeName="stroke-dashoffset" from="100" to="0" dur="2s" begin="0.85s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0;0;0.8;0.8;0" keyTimes="0;0.15;0.4;0.7;1" dur="2s" begin="0.85s" repeatCount="indefinite" />
      </path>

      <path d="M 200 60 L 200 140 L 170 170 L 80 170" class="trace" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M 200 60 L 200 140 L 170 170 L 80 170" class="trace-pulse" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="12 88" stroke-dashoffset="100" opacity="0">
        <animate attributeName="stroke-dashoffset" from="100" to="0" dur="3s" begin="0.35s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0;0;0.9;0.9;0" keyTimes="0;0.15;0.4;0.7;1" dur="3s" begin="0.35s" repeatCount="indefinite" />
      </path>

