---
import Layout from '../layouts/Layout.astro';
import FaqItem from '../components/FaqItem.astro';

const SERVICES = [
  {
    icon: "globe",
    title: "Web",
    accent: "Dev",
    body: "High-performance web applications, corporate sites, and landing pages built for heavy traffic and measurable conversion.",
    points: [
      "Responsive front ends with a performance budget",
      "Scalable CMS and content model integrations",
      "Core Web Vitals tracked in production, not just in dev",
    ],
    cta: "Start building",
    dark: false,
  },
  {
    icon: "code",
    title: "Custom",
    accent: "Software",
    body: "Internal tools, automation systems, and SaaS platforms engineered around distinct operational workflows.",
    points: [
      "Secure REST and GraphQL APIs with typed contracts",
      "Complex dashboards over live operational data",
      "Cloud and backend systems designed for failure",
    ],
    cta: "Request a demo",
    dark: true,
  },
  {
    icon: "zap",
    title: "Digital",
    accent: "Acceleration",
    body: "Legacy modernization in short, shippable increments, so the business keeps running while the platform changes underneath it.",
    points: [
      "Incremental migration with no big-bang cutover",
      "Observability and rollback on every release",
      "Knowledge transfer to your in-house team",
    ],
    cta: "Plan a migration",
    dark: false,
  },
];

const ENGAGEMENTS = [
  {
    title: "Sprint",
    duration: "2–4 weeks",
    body: "A focused build or audit with a single deliverable: a prototype, a performance rescue, an architecture review.",
  },
  {
    title: "Build",
    duration: "2–6 months",
    body: "A full platform delivered end to end, from data model and infrastructure through to the shipped interface.",
  },
  {
    title: "Partner",
    duration: "Ongoing",
    body: "An embedded team working alongside yours on a continuous release cadence with shared roadmap ownership.",
  },
];

const STACK = [
  { name: "AWS", role: "Cloud Native" },
  { name: "React", role: "Frontend" },
  { name: "TypeScript", role: "Type safety" },
  { name: "Python", role: "Data & Backend" },
  { name: "Postgres", role: "Persistence" },
  { name: "Docker", role: "Containers" },
];

const FAQ_ITEMS = [
  {
    q: 'How much does it cost to develop a web platform?',
    a: 'Our professional websites start from $500. Custom software and ERP platforms start from $2,500+ depending on scope, integrations, and technical complexity. Every project receives a clear quote before we start.',
  },
  {
    q: 'How long does a web or software project take?',
    a: 'Most website projects take between 1 and 3 weeks. Full custom platforms typically take 1–6 months. Every engagement is structured in clear milestones so you never wonder where things stand.',
  },
  {
    q: 'Can I hire maintenance and support after launch?',
    a: 'Yes. Our ongoing engineering partnerships start at $50/month and cover maintenance, support, hosting, and updates. A maintained site stays fast, secure, and relevant.',
  },
  {
    q: 'What technologies power your projects?',
    a: 'Our default toolkit includes React, Astro, NextJS, TypeScript, Python, PostgreSQL, Docker, .NET, and Go. More importantly, we choose the right stack for each project instead of forcing a one-size-fits-all solution.',
  },
];
---

<Layout title="Services | Horizon.gh - Transforming the Digital Horizon" description="Horizon gh delivers high-performance web applications, custom software, and digital acceleration built on robust, scalable infrastructure.">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Services Hero -->
    <section class="border-b border-gray-200 py-24 text-center">
      <div class="shell mx-auto max-w-7xl px-6">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          Our Ecosystem
        </p>
        <h1 class="display-xl mx-auto mt-8 max-w-4xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Architecting the <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">future</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          We build robust, scalable infrastructures that accelerate your digital transformation.
        </p>
      </div>
    </section>

    <!-- Core Solutions -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="offerings-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 id="offerings-heading" class="sr-only">Service offerings</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {SERVICES.map((service) => (
            <article
              class={`group flex flex-col rounded-2xl border p-8 transition-all hover:-translate-y-1 ${
                service.dark
                  ? 'border-[#1f2937] bg-[#111827] text-[#f7f9fc]'
                  : 'border-gray-200 bg-white shadow-sm hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)]'
              }`}
            >
              <span
                class={`inline-flex w-12 h-12 items-center justify-center rounded-xl ${
                  service.dark
                    ? 'bg-[#ffffff]/10 text-[var(--color-accent-cyan)]'
                    : 'bg-[var(--color-accent-cyan)]/10 text-[var(--color-accent-cyan)]'
                }`}
              >
                {service.icon === 'globe' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                )}
                {service.icon === 'code' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {service.icon === 'zap' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
              </span>
              <h3 class="mt-8 text-3xl font-display font-bold">
                {service.title} <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-4xl">{service.accent}</span>
              </h3>
              <p class={`mt-4 ${service.dark ? 'text-[#9ca3af]' : 'text-gray-600'}`}>
                {service.body}
              </p>
              <ul class="mt-8 flex-1 space-y-3">
                {service.points.map((point) => (
                  <li class="flex gap-3 text-sm">
                    <span class="mt-0.5 text-[var(--color-accent-cyan)]">&#10003;</span>
                    <span class={service.dark ? 'text-[#d1d5db]' : 'text-gray-800'}>{point}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/contact"
                class={`mt-10 inline-flex items-center gap-2 self-start border-b-2 pb-1 font-bold transition-colors ${
                  service.dark
                    ? 'border-[var(--color-accent-cyan)] text-[var(--color-accent-cyan)] hover:text-[#ffffff]'
                    : 'border-gray-900 hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)]'
                }`}
              >
                {service.cta}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Engagements Section -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="engagements-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 id="engagements-heading" class="display-lg text-gray-900">
          How we <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">engage</span>
        </h2>
        <div class="mt-14 grid gap-10 md:grid-cols-3">
          {ENGAGEMENTS.map((item) => (
            <article class="border-t-2 border-gray-900 pt-6">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-2xl font-display font-bold">{item.title}</h3>
                <span class="label-sm text-[var(--color-accent-cyan)]">{item.duration}</span>
              </div>
              <p class="mt-3 text-gray-600">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="stack-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 id="stack-heading" class="display-lg text-gray-900">
          Our <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">arsenal</span>
        </h2>
        <ul class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
          {STACK.map((tool) => (
            <li
              class="rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm transition-colors hover:border-[var(--color-accent-cyan)]"
            >
              <span class="block font-display text-xl font-extrabold">{tool.name}</span>
              <span class="mt-1 block text-xs text-gray-600">{tool.role}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20" aria-labelledby="services-faq-heading">
      <div class="shell mx-auto max-w-3xl px-6">
        <h2 id="services-faq-heading" class="display-lg text-gray-900 text-center">
          Common <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">questions</span>
        </h2>
        <div class="mt-14 space-y-4">
          {FAQ_ITEMS.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
        <p class="mt-12 text-center text-gray-600">
          Have a different question?{' '}
          <a href="/faq" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            See our full FAQ
          </a>{' '}
          or{' '}
          <a href="/contact" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            talk to us directly
          </a>.
        </p>
      </div>
    </section>
  </div>
</Layout>