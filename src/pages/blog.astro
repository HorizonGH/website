---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog_en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = posts[0];
const rest = posts.slice(1);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
---

<Layout title="Insights | Horizon.gh - Transforming the Digital Horizon">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-[#f4f7fb] text-gray-900 font-sans">
    <!-- Blog Hero -->
    <section class="border-b border-gray-200 py-20">
      <div class="shell mx-auto max-w-7xl px-6">
        <h1 class="display-xl max-w-3xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Engineering <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">insights</span>
        </h1>
        <p class="body-lg mt-8 max-w-xl text-gray-600">
          Deep dives into software architecture, digital transformation, and the tech
          landscape our clients are building for.
        </p>
      </div>
    </section>

    <!-- Articles -->
    <section class="py-20" aria-labelledby="articles-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 id="articles-heading" class="sr-only">Latest articles</h2>

        {featured && (
          <article class="group grid overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)] lg:grid-cols-2">
            {featured.data.coverImage && (
              <img
                alt={featured.data.title}
                src={featured.data.coverImage}
                class="h-64 w-full object-cover lg:h-full"
              />
            )}
            <div class="flex flex-col p-8 lg:p-12">
              <div class="flex items-center gap-3">
                <span class="label-sm rounded-full bg-[var(--color-accent-cyan)] px-3 py-1 text-black">
                  {featured.data.category}
                </span>
                <span class="text-xs text-gray-600">{featured.data.readTime}</span>
              </div>
              <h3 class="mt-6 text-3xl lg:text-4xl font-display font-bold text-gray-900">{featured.data.title}</h3>
              <p class="mt-4 flex-1 text-gray-600">{featured.data.excerpt}</p>
              <div class="mt-8 flex items-center justify-between border-t border-gray-200 pt-6">
                <time class="text-xs text-gray-600">{formatDate(featured.data.date)}</time>
                <a href={`/blog/${featured.id}`} class="inline-flex items-center gap-2 text-sm font-bold text-gray-900 transition-colors group-hover:text-[var(--color-accent-cyan)]">
                  Read
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        )}

        {rest.length > 0 && (
          <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <article
                class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)]"
              >
                {post.data.coverImage && (
                  <img
                    alt={post.data.title}
                    src={post.data.coverImage}
                    loading="lazy"
                    class="h-48 w-full object-cover"
                  />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center gap-3">
                    <span class="label-sm rounded-full bg-[var(--color-accent-cyan)]/10 px-3 py-1 text-[var(--color-accent-cyan)]">
                      {post.data.category}
                    </span>
                    <span class="text-xs text-gray-600">{post.data.readTime}</span>
                  </div>
                  <h3 class="mt-5 text-xl font-display font-bold text-gray-900">{post.data.title}</h3>
                  <p class="mt-3 flex-1 text-sm text-gray-600">{post.data.excerpt}</p>
                  <div class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4">
                    <time class="text-xs text-gray-600">{formatDate(post.data.date)}</time>
                    <a href={`/blog/${post.id}`} class="inline-flex items-center gap-2 text-sm font-bold text-gray-900 transition-colors group-hover:text-[var(--color-accent-cyan)]">
                      Read
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>

  <Footer />
</Layout>