---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog_en');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
---

<Layout title={`${post.data.title} | Horizon.gh`}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-[#f4f7fb] text-gray-900 font-sans">
    <!-- Article Header -->
    <section class="border-b border-gray-200 py-20">
      <div class="shell mx-auto max-w-4xl px-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-bold text-gray-600 transition-colors hover:text-[var(--color-accent-cyan)]"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to insights
        </a>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <span class="label-sm rounded-full bg-[var(--color-accent-cyan)]/10 px-3 py-1 text-[var(--color-accent-cyan)]">
            {post.data.category}
          </span>
          <span class="text-xs text-gray-600">{post.data.readTime}</span>
          <span class="text-xs text-gray-600">{formatDate(post.data.date)}</span>
        </div>

        <h1 class="mt-8 max-w-3xl font-display text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl leading-[1.05]">
          {post.data.title}
        </h1>
        <p class="body-lg mt-6 max-w-2xl text-gray-600">
          {post.data.excerpt}
        </p>

        <div class="mt-10 flex items-center gap-4 border-t border-gray-200 pt-6">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-accent-cyan)]/10 font-display text-sm font-bold text-[var(--color-accent-cyan)]">
            {post.data.author
              .split(' ')
              .map((word: string) => word[0])
              .join('')}
          </div>
          <div>
            <p class="font-display font-bold text-gray-900">{post.data.author}</p>
            <p class="text-sm text-gray-600">{post.data.category}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Article Body -->
    <section class="py-20">
      <div class="shell mx-auto max-w-4xl px-6">
        <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
          {post.data.coverImage && (
            <img
              alt={post.data.title}
              src={post.data.coverImage}
              class="h-64 w-full object-cover sm:h-96"
            />
          )}
          <div class="p-8 sm:p-12">
            <div class="blog-content">
              <Content />
            </div>
          </div>
        </article>

        <aside class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-display font-bold text-gray-900">Article details</h2>
            <div class="mt-4 space-y-3 text-sm text-gray-600">
              <div>
                <p class="font-semibold text-gray-900">Category</p>
                <p>{post.data.category}</p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Reading time</p>
                <p>{post.data.readTime}</p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Published</p>
                <p>{formatDate(post.data.date)}</p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-display font-bold text-gray-900">Related</h2>
            <p class="mt-4 text-sm text-gray-600">
              Explore more articles and engineering discoveries on the insights page.
            </p>
            <a
              href="/blog"
              class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-gray-900 transition-colors hover:text-[var(--color-accent-cyan)]"
            >
              View all articles
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </aside>
      </div>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  .blog-content :global(h2) {
    margin: 2.5rem 0 1.2rem;
    font-size: 2rem;
    font-family: var(--font-display);
    color: var(--color-on-surface);
  }

  .blog-content :global(h3) {
    margin: 2rem 0 0.8rem;
    font-size: 1.45rem;
    font-family: var(--font-display);
    color: var(--color-on-surface);
  }

  .blog-content :global(p) {
    margin: 0 0 1.3rem;
    line-height: 1.8;
    color: var(--color-on-surface-variant);
    font-size: 1rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
    padding-left: 1rem;
    color: var(--color-on-surface-variant);
    line-height: 1.8;
  }

  .blog-content :global(li) {
    margin-bottom: 0.65rem;
  }

  .blog-content :global(a) {
    color: var(--color-accent-cyan);
    text-decoration: underline;
  }

  .blog-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.6rem 1.8rem;
    border-left: 4px solid var(--color-accent-cyan);
    background: rgba(76, 214, 251, 0.06);
    color: var(--color-on-surface);
    border-radius: 1rem;
  }

  .blog-content :global(pre) {
    margin: 1.5rem 0;
    overflow-x: auto;
    border-radius: 1rem;
    background: #0d0d0d;
    padding: 1rem;
  }

  .blog-content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    background: rgba(76, 214, 251, 0.12);
    padding: 0.2rem 0.35rem;
    border-radius: 0.45rem;
    color: var(--color-accent-cyan);
  }
</style>
