---
import Layout from '../layouts/Layout.astro';

const CONTACT = '/contact';

const PLANS = [
  {
    icon: 'globe',
    title: 'Professional',
    accent: 'Website',
    priceLabel: 'From',
    price: '$500',
    tagline:
      'A complete, modern website that helps customers find, trust, and contact your business from any device.',
    features: [
      'Professional website',
      'Modern design',
      'Responsive (mobile-friendly)',
      'Basic SEO',
      'Contact form',
      'WhatsApp integration',
      'Google Maps',
      'Domain & hosting',
    ],
    cta: 'Get started',
    featured: false,
  },
  {
    icon: 'erp',
    title: 'ERP for',
    accent: 'Businesses',
    priceLabel: 'From',
    price: '$2,500',
    tagline:
      'A tailored ERP that runs inventory, customers, billing, and reporting — all your operations in one place.',
    features: ['Inventory', 'Customers', 'Invoicing', 'Reports', 'Users'],
    cta: 'Request a demo',
    featured: false,
  },
  {
    icon: 'code',
    title: 'Custom',
    accent: 'Software',
    priceLabel: 'Price',
    price: 'To be discussed',
    priceCompact: true,
    badge: 'Tailored',
    tagline:
      'A bespoke system engineered around how your team actually works, with a clear scope and quote before we start.',
    features: [
      'Web apps, internal tools & SaaS',
      'APIs & third-party integrations',
      'Admin dashboards & reporting',
      'Tailored to your workflow',
      'Clear scope and quote up front',
    ],
    cta: 'Request a quote',
    featured: true,
  },
];

const MAINTENANCE = {
  icon: 'wrench',
  title: 'Monthly',
  accent: 'Maintenance',
  subtitle: 'Optional add-on',
  priceLabel: 'From',
  price: '$50',
  priceUnit: '/month',
  tagline:
    'Keep your site fast, secure, and up to date with ongoing care tailored to the scope you need.',
  featuresLabel: 'Included depending on scope',
  features: ['Maintenance', 'Support', 'Updates', 'Hosting'],
  cta: 'Learn more about maintenance',
};
---

<Layout title="Pricing | Horizon.gh - Transforming the Digital Horizon" description="Transparent pricing for professional websites, ERPs for small businesses, and custom software — from $500, with every project scoped before we start.">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Pricing Hero -->
    <section class="border-b border-gray-200 py-24 text-center">
      <div class="shell mx-auto max-w-7xl px-6">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          Pricing
        </p>
        <h1 class="display-xl mx-auto mt-8 max-w-4xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Simple, honest <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">pricing</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          Transparent packages for websites, custom software, and ongoing care. Every project is
          scoped before we start, so you always know where you stand.
        </p>
      </div>
    </section>

    <!-- Plans -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="plans-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 id="plans-heading" class="sr-only">Service plans and pricing</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {PLANS.map((plan) => (
            <article
              class={`group relative flex flex-col rounded-2xl border p-8 transition-all hover:-translate-y-1 ${
                plan.featured
                  ? 'border-[#1f2937] bg-[#111827] text-[#f7f9fc]'
                  : 'border-gray-200 bg-white shadow-sm hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)]'
              }`}
            >
              {plan.badge && (
                <span class="absolute -top-3.5 left-8 label-sm rounded-full bg-[var(--color-accent-cyan)] px-3 py-1 text-black">
                  {plan.badge}
                </span>
              )}

              <div class="flex items-start justify-between gap-4">
                <span
                  class={`inline-flex w-12 h-12 items-center justify-center rounded-xl ${
                    plan.featured
                      ? 'bg-[#ffffff]/10 text-[var(--color-accent-cyan)]'
                      : 'bg-[var(--color-accent-cyan)]/10 text-[var(--color-accent-cyan)]'
                  }`}
                >
                  {plan.icon === 'globe' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                  )}
                  {plan.icon === 'code' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  )}
                  {plan.icon === 'erp' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  )}
                </span>
              </div>

              <h3 class="mt-8 text-3xl font-display font-bold">
                {plan.title} <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-4xl">{plan.accent}</span>
              </h3>

              <p class="mt-6">
                <span class={`label-sm ${plan.featured ? 'text-[#9ca3af]' : 'text-gray-500'}`}>{plan.priceLabel}</span>
                <span class={`mt-1 block font-display font-black ${plan.featured ? 'text-[#f7f9fc]' : 'text-gray-900'} ${plan.priceCompact ? 'text-4xl' : 'text-5xl'}`}>
                  {plan.price}
                </span>
              </p>

              <p class={`mt-6 ${plan.featured ? 'text-[#9ca3af]' : 'text-gray-600'}`}>{plan.tagline}</p>

              <ul class="mt-8 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex gap-3 text-sm">
                    <span class="mt-0.5 text-[var(--color-accent-cyan)]">&#10003;</span>
                    <span class={plan.featured ? 'text-[#d1d5db]' : 'text-gray-800'}>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href={CONTACT}
                class={`mt-10 inline-flex items-center gap-2 self-start border-b-2 pb-1 font-bold transition-colors ${
                  plan.featured
                    ? 'border-[var(--color-accent-cyan)] text-[var(--color-accent-cyan)] hover:text-[#f7f9fc]'
                    : 'border-gray-900 hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)]'
                }`}
              >
                {plan.cta}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Monthly Maintenance -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="maintenance-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <article class="flex flex-col gap-10 rounded-2xl border border-[#1f2937] bg-[#111827] p-8 text-[#f7f9fc] lg:flex-row lg:items-center lg:p-12">
          <div class="lg:w-1/3">
            <span class="inline-flex w-12 h-12 items-center justify-center rounded-xl bg-[#ffffff]/10 text-[var(--color-accent-cyan)]">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <h3 id="maintenance-heading" class="mt-6 text-3xl font-display font-bold">
              {MAINTENANCE.title} <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-4xl">{MAINTENANCE.accent}</span>
            </h3>
            <p class="label-sm mt-2 text-[#9ca3af]">{MAINTENANCE.subtitle}</p>
            <p class="mt-6">
              <span class="label-sm text-[#9ca3af]">{MAINTENANCE.priceLabel}</span>
              <span class="mt-1 block font-display text-5xl font-black text-[#f7f9fc]">
                {MAINTENANCE.price}<span class="text-2xl text-[#9ca3af]">{MAINTENANCE.priceUnit}</span>
              </span>
            </p>
          </div>

          <div class="lg:flex-1">
            <p class="text-[#d1d5db]">{MAINTENANCE.tagline}</p>
            <p class="label-sm mt-8 text-[var(--color-accent-cyan)]">{MAINTENANCE.featuresLabel}</p>
            <ul class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
              {MAINTENANCE.features.map((feature) => (
                <li class="flex items-center gap-2 text-sm text-[#d1d5db]">
                  <span class="text-[var(--color-accent-cyan)]">&#10003;</span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <a
            href={CONTACT}
            class="inline-flex items-center gap-2 self-start rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)] lg:self-center"
          >
            {MAINTENANCE.cta}
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="border-b border-gray-200 bg-white py-24">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          Not sure which <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">plan</span> fits?
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Tell us about your project and we'll recommend the right scope — no obligation, no surprises.
        </p>
        <a
          href={CONTACT}
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Start the conversation
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>
