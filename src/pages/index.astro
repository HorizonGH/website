---
import Layout from '../layouts/Layout.astro';
import HeroCircuitBackdrop from '../components/HeroCircuitBackdrop.astro';

const TITLE = "Custom Software & Web Development for Growing Businesses | Horizon.gh";
const DESCRIPTION =
  "Horizon gh builds scalable web platforms, custom software and ERP systems designed for real-world growth. Web development, custom software, and ERP for growing businesses.";

const SERVICES = [
  {
    title: "Web Architecture",
    body: "Scalable, resilient front ends and delivery layers built on modern frameworks, measured against Core Web Vitals rather than opinion.",
    metric: "Sub-second LCP targets",
    icon: "globe",
  },
  {
    title: "Custom Platforms",
    body: "Bespoke internal tools, dashboards, and SaaS products shaped around how your team actually works instead of a template's assumptions.",
    metric: "REST & GraphQL APIs",
    icon: "code",
  },
  {
    title: "Digital Acceleration",
    body: "Modernization of legacy systems in short, shippable cycles, so value lands in production while the migration is still running.",
    metric: "2-week release cadence",
    icon: "zap",
  },
];

const PROCESS = [
  {
    step: "01",
    title: "Discovery",
    body: "We map the terrain: current systems, constraints, traffic, and the outcome that actually matters. You leave with a written technical thesis.",
  },
  {
    step: "02",
    title: "Synthesis",
    body: "Design and engineering move together. Interface, data model, and infrastructure are decided in the same room, not handed over a wall.",
  },
  {
    step: "03",
    title: "Deployment",
    body: "Ship behind instrumentation. Every release carries monitoring, rollback, and a performance budget you can hold us to.",
  },
];

const WORKS = [
  {
    client: "HorizonFood",
    tag: "ERP System",
    title: "Restaurant inventory management",
    body: "A comprehensive ERP system for restaurants, managing ingredients, stock levels, and real-time workflow tracking across multiple locations.",
    result: "30% less food waste",
    featured: true,
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1785617753/Screenshot_2026-08-01_165533_mtuvjx.png",
  },
  {
    client: "Azure Marine",
    tag: "Yacht Charter",
    title: "Booking and fleet management",
    body: "An availability engine and editorial site for a charter fleet, replacing spreadsheets and phone reservations.",
    result: "38% more direct bookings",
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1776224245/Screenshot_2026-04-14_233508_motvm1.jpg",
  },
  {
    client: "Oasis Logistic",
    tag: "Logistics",
    title: "Shipment tracking backbone",
    body: "Event-driven tracking across carriers, surfaced through one customer-facing timeline and an internal ops view.",
    result: "12 carrier integrations",
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1776224244/Screenshot_2026-04-14_233436_dyhlu8.jpg",
  },
];

const TESTIMONIALS = [
  {
    quote:
      "Horizon rebuilt our backend infrastructure without a day of downtime. Their combination of architectural rigor and interface craft is genuinely rare.",
    name: "John Marsh",
    role: "CTO, TechHub",
    avatar: "Jhon+M",
  },
  {
    quote:
      "The performance work they did on our storefront moved conversion 40% in six weeks. Every change came with a measurement attached.",
    name: "Sarah Aldridge",
    role: "Director of Digital, Northline Retail",
    avatar: "Sarah+A",
  },
  {
    quote:
      "They don't just deliver a website. They hand you a platform your own engineers can keep extending after the engagement ends.",
    name: "Daniel Quesada",
    role: "Founder, QuesaData",
    avatar: "Daniel+Q",
  },
];
---

<Layout title={TITLE} description={DESCRIPTION}>
  <!-- Add Cursive Font for the signatures -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-gray-200">
      <HeroCircuitBackdrop />
      <div class="shell relative flex min-h-[78vh] flex-col items-center justify-center py-24 text-center">
        <p class="label-sm text-gray-500">Engineered in America</p>
        <h1 class="display-xl mt-6 max-w-4xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl lg:text-[5.8rem]">
          Custom Software &amp; Web<br/>Development for <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">Growing</span> Businesses
        </h1>
        <p class="body-lg mt-8 max-w-xl text-gray-600">
          We build scalable web platforms, custom software and digital infrastructure
          designed for real-world growth.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#contact"
            class="group inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)] hover:-translate-y-0.5"
          >
            Get a free consultation
            <svg class="ml-2 h-5 w-5 transition-transform group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </a>
          <a
            href="/services"
            class="inline-flex items-center gap-2 border-b-2 border-gray-900 pb-1 text-base font-bold transition-colors hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)]"
          >
            See what we build
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="services-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="services-heading" class="display-lg text-gray-900 max-w-lg">
            Our <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">services</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Three practices, one engineering standard. Most engagements start with one
            and grow into the others.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {SERVICES.map((service) => (
            <article
              key={service.title}
              class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)]"
            >
              <h3 class="text-2xl font-display font-bold">{service.title}</h3>
              <p class="mt-4 flex-1 text-gray-600">{service.body}</p>
              <p class="label-sm mt-8 text-[var(--color-accent-cyan)]">{service.metric}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="process-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 class="display-lg text-gray-900">
          The <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">framework</span>
        </h2>
        <ol class="mt-14 grid gap-10 md:grid-cols-3">
          {PROCESS.map((phase) => (
            <li key={phase.step} class="border-t-2 border-gray-900 pt-6">
              <span class="font-display text-5xl font-black text-[var(--color-accent-cyan)]">{phase.step}</span>
              <h3 class="mt-4 text-xl font-display font-bold">{phase.title}</h3>
              <p class="mt-3 text-gray-600">{phase.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Portfolio / Selected Works Section -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="work-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="work-heading" class="display-lg text-gray-900">
            Selected <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">works</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Representative engagements. Detailed case studies available on request.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {WORKS.map((item) => (
            <article
              key={item.client}
              class={`group relative flex flex-col rounded-2xl overflow-hidden border border-gray-200 bg-cover bg-center transition-all hover:border-[var(--color-accent-cyan)]/60 ${
                item.featured ? "md:col-span-2" : ""
              }`}
              style={`background-image: url('${item.image}');`}
            >
              <div class="absolute inset-0 bg-gradient-to-t from-[#000]/90 via-[#000]/40 to-transparent z-10"></div>
              <div class="relative z-20 flex flex-col p-8 min-h-[320px] justify-end">
                <div class="flex items-center gap-3">
                  <span class="label-sm text-[var(--color-accent-cyan)]">{item.client}</span>
                  <span class="text-xs text-[#ffffff]/40">{item.tag}</span>
                </div>
                <h3 class="mt-4 text-2xl md:text-3xl font-display font-bold text-[#ffffff]">{item.title}</h3>
                <p class="mt-3 max-w-xl text-[#ffffff]/60">{item.body}</p>
                <p class="mt-6 font-display text-lg font-bold text-[var(--color-accent-cyan)]">{item.result}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="testimonials-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 class="display-lg text-gray-900">
          Client <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">perspectives</span>
        </h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {TESTIMONIALS.map((item) => (
            <figure
              key={item.name}
              class="flex flex-col rounded-2xl border border-[#1f2937] bg-[#111827] p-8 shadow-xl"
            >
              <blockquote class="flex-1 text-lg leading-relaxed text-[#f3f4f6]">
                &ldquo;{item.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-8 border-t border-[#1f2937] pt-5 flex items-center gap-4">
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-[var(--color-accent-cyan)] flex-shrink-0">
                  <img
                    src={`https://ui-avatars.com/api/?name=${item.avatar}&background=4CD6FB&color=000`}
                    alt={item.name}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <span class="block font-bold text-[#ffffff]">{item.name}</span>
                  <span class="text-sm text-[#9ca3af]">{item.role}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Ready to Build CTA Section -->
    <section class="py-24 border-b border-gray-200 bg-white">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          Ready to <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">build?</span>
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Tell us what you're trying to ship. We'll reply within one business day with a
          point of view, not a brochure.
        </p>
        <a
          href="#contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Start the conversation
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>