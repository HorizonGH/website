---
import Layout from '../layouts/Layout.astro';
import HeroCircuitBackdrop from '../components/HeroCircuitBackdrop.astro';
import FaqItem from '../components/FaqItem.astro';

const TITLE = 'Professional Web Development for Growing Businesses | Horizon.gh';
const DESCRIPTION =
  'High-performance websites, landing pages and web applications built for conversion, speed, and scalability. Responsive design, CMS integrations, and Core Web Vitals optimization.';

const FEATURES = [
  {
    title: 'Custom Websites',
    body: 'Professional websites engineered for your brand, with modern design, responsive layouts, and performance budgets measured in production.',
  },
  {
    title: 'Landing Pages',
    body: 'High-conversion landing pages optimized for speed and clarity. Every pixel, every word, and every millisecond is measured against your conversion goal.',
  },
  {
    title: 'Corporate Platforms',
    body: 'Scalable CMS-powered platforms that let your marketing team own content while engineering holds the reliability line.',
  },
  {
    title: 'Responsive Everywhere',
    body: 'Every page is tested on mobile, tablet, and desktop to ensure a consistent, polished experience across all devices.',
  },
  {
    title: 'Core Web Vitals',
    body: 'LCP, CLS, and INP tracked from dev to production. We ship fast and we prove it with numbers, not opinions.',
  },
  {
    title: 'SEO & Accessibility',
    body: 'Semantic HTML, descriptive link text, meta tags, and proper landmarks. Your site ships ready for search engines and screen-reader users alike.',
  },
];

const FAQ_ITEMS = [
  {
    q: 'How much does a professional website cost?',
    a: 'Our websites start at $500 for a complete, professional site including design, development, responsive layout, basic SEO, and hosting. Custom enterprise solutions scale from there.',
  },
  {
    q: 'How long does web development take?',
    a: 'Most websites are delivered in 2-6 weeks. Enterprise platforms take longer, but we ship in milestones so you see working software consistently.',
  },
  {
    q: 'Will my site be mobile-friendly?',
    a: 'Absolutely. Every site we ship is tested on mobile, tablet, and desktop. Responsive design is not an add-on at Horizon &mdash; it is the baseline.',
  },
];
---

<Layout title={TITLE} description={DESCRIPTION} keywords="web development, website development, responsive web design, landing pages, corporate websites, frontend development">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-gray-200">
      <HeroCircuitBackdrop />
      <div class="shell relative flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          Web Development
        </p>
        <h1 class="display-xl mt-8 max-w-5xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Websites that <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">perform</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          Professional websites, landing pages, and corporate platforms engineered for real traffic and measurable business outcomes.
        </p>
        <a
          href="/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Start your project
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <!-- What We Build -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="build-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="build-heading" class="display-lg text-gray-900 max-w-lg">
            What we <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">build</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Every pixel serves a purpose. Every release carries a measurement.
          </p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {FEATURES.map((feature) => (
            <article class="group rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)]">
              <h3 class="text-xl font-display font-bold">{feature.title}</h3>
              <p class="mt-4 text-gray-600">{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-gray-200 py-20" aria-labelledby="web-faq-heading">
      <div class="shell mx-auto max-w-3xl px-6">
        <h2 id="web-faq-heading" class="display-lg text-gray-900 text-center">
          Common <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">questions</span>
        </h2>
        <div class="mt-14 space-y-4">
          {FAQ_ITEMS.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
        <p class="mt-12 text-center text-gray-600">
          Have more questions?{' '}
          <a href="/faq" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            See our full FAQ
          </a>{' '}
          or{' '}
          <a href="/services" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            explore our services
          </a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gray-50">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          Ready to ship your <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">site?</span>
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Talk to us about your website project. We'll get a structured recommendation back to you quickly.
        </p>
        <a
          href="/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Start the conversation
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>