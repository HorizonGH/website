---
import Layout from '../../layouts/Layout.astro';
import FaqItem from '../../components/FaqItem.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('es') as any;

const FAQ_ITEMS = (t.faq.items as Array<{ q: string; a: string }>) ?? [];
---

<Layout
  locale="es"
  title={t.faq.page_title}
  description={t.faq.page_desc}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- FAQ Hero -->
    <section class="border-b border-gray-200 py-20 text-center">
      <div class="shell mx-auto max-w-7xl px-6">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          {t.faq.hero_badge}
        </p>
        <h1 class="display-xl mx-auto mt-8 max-w-3xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          {t.faq.hero_title} <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">{t.faq.hero_emphasis}</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          {t.faq.hero_subtitle}
        </p>
      </div>
    </section>

    <!-- FAQ Items -->
    <section class="py-20">
      <div class="shell mx-auto max-w-3xl px-6 space-y-4">
        <h2 class="sr-only">{t.faq.section_title}</h2>
        {FAQ_ITEMS.map((item) => <FaqItem question={item.q} answer={item.a} />)}

        <!-- CTA -->
        <div class="mt-16 rounded-2xl border border-[var(--color-accent-cyan)]/20 bg-[var(--color-accent-cyan)]/5 p-8 text-center">
          <p class="text-lg font-display font-bold">
            {t.faq.cta_prefix}
          </p>
          <p class="mt-2 text-gray-600">
            Cuéntanos sobre tu proyecto y te daremos los detalles que necesitas.
          </p>
          <a
            href="/es/contact"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
          >
            {t.faq.cta_text}
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>