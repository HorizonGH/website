---
import Layout from '../../layouts/Layout.astro';
import HeroCircuitBackdrop from '../../components/HeroCircuitBackdrop.astro';
import FaqItem from '../../components/FaqItem.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('es') as any;

const FEATURES = [
  {
    title: 'Sitios web personalizados',
    body: 'Sitios web profesionales diseñados para tu marca, con diseño moderno, layouts responsivos y presupuestos de rendimiento medidos en producción.',
  },
  {
    title: 'Landing pages',
    body: 'Páginas de aterrizaje de alta conversión optimizadas para velocidad y claridad. Cada píxel, palabra y milisegundo se mide contra tu objetivo de conversión.',
  },
  {
    title: 'Plataformas corporativas',
    body: 'Plataformas escalables con CMS que permiten a tu equipo de marketing gestionar el contenido mientras la ingeniería mantiene la fiabilidad.',
  },
  {
    title: 'Responsive en todas partes',
    body: 'Cada página se prueba en móvil, tablet y escritorio para garantizar una experiencia consistente y pulida en todos los dispositivos.',
  },
  {
    title: 'Core Web Vitals',
    body: 'LCP, CLS e INP monitorizados desde desarrollo hasta producción. Entregamos rápido y lo demostramos con números, no con opiniones.',
  },
  {
    title: 'SEO y accesibilidad',
    body: 'HTML semántico, textos de enlace descriptivos, meta tags y landmarks apropiados. Tu sitio se publica listo para motores de búsqueda y lectores de pantalla.',
  },
];

const FAQ_ITEMS = [
  {
    q: '¿Cuánto cuesta un sitio web profesional?',
    a: 'Nuestros sitios web comienzan desde $500 para un sitio profesional completo que incluye diseño, desarrollo, layout responsive, SEO básico y hosting. Las soluciones empresariales personalizadas escalan desde ahí.',
  },
  {
    q: '¿Cuánto tarda el desarrollo web?',
    a: 'La mayoría de los sitios web se entregan en 2-6 semanas. Las plataformas empresariales toman más tiempo, pero entregamos en hitos para que veas software funcionando de forma consistente.',
  },
  {
    q: '¿Mi sitio será compatible con móviles?',
    a: 'Absolutamente. Cada sitio que entregamos se prueba en móvil, tablet y escritorio. El diseño responsive no es un extra en Horizon &mdash; es la línea base.',
  },
];
---

<Layout
  locale="es"
  title="Desarrollo Web Profesional para Negocios en Crecimiento | Horizon.gh"
  description="Sitios web de alto rendimiento y apps web para conversión, velocidad y escalabilidad. Diseño responsive, CMS y optimización Core Web Vitals."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-gray-200">
      <HeroCircuitBackdrop />
      <div class="shell relative flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          Desarrollo Web
        </p>
        <h1 class="display-xl mt-8 max-w-5xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Sitios web que <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">rinden</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          Sitios web profesionales, landing pages y plataformas corporativas diseñadas para tráfico real y resultados de negocio medibles.
        </p>
        <a
          href="/es/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Comienza tu proyecto
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <!-- What We Build -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="build-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="build-heading" class="display-lg text-gray-900 max-w-lg">
            Lo que <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">construimos</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Cada píxel tiene un propósito. Cada entrega lleva una medición.
          </p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {FEATURES.map((feature) => (
            <article class="group rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)]">
              <h3 class="text-xl font-display font-bold">{feature.title}</h3>
              <p class="mt-4 text-gray-600">{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-gray-200 py-20" aria-labelledby="web-faq-heading">
      <div class="shell mx-auto max-w-3xl px-6">
        <h2 id="web-faq-heading" class="display-lg text-gray-900 text-center">
          Preguntas <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">frecuentes</span>
        </h2>
        <div class="mt-14 space-y-4">
          {FAQ_ITEMS.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
        <p class="mt-12 text-center text-gray-600">
          ¿Tienes más preguntas?{' '}
          <a href="/es/faq" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            Ver todas las FAQ
          </a>{' '}
          o{' '}
          <a href="/es/services" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            explora nuestros servicios
          </a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gray-50">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          ¿Listo para lanzar tu <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">sitio?</span>
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Habla con nosotros sobre tu proyecto web. Te enviaremos una recomendación estructurada rápidamente.
        </p>
        <a
          href="/es/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Inicia la conversación
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>