---
import Layout from '../../layouts/Layout.astro';
import HeroCircuitBackdrop from '../../components/HeroCircuitBackdrop.astro';
import FaqItem from '../../components/FaqItem.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('es') as any;

const FEATURES = [
  {
    title: 'Plataformas a medida',
    body: 'Productos SaaS personalizados y herramientas internas construidas alrededor de cómo trabaja tu equipo, no de una plantilla genérica.',
  },
  {
    title: 'APIs seguras',
    body: 'APIs REST y GraphQL con contratos tipados, limitación de velocidad y patrones zero-trust incorporados desde el primer día.',
  },
  {
    title: 'Paneles de administración',
    body: 'Paneles de analítica operativa que muestran datos en vivo de tus sistemas, dándole a tu equipo los insights que impulsan decisiones.',
  },
  {
    title: 'Integraciones externas',
    body: 'Conecta tu plataforma con CRMs, ERPs, procesadores de pago y cualquier servicio externo del que dependan tus operaciones.',
  },
  {
    title: 'Infraestructura cloud',
    body: 'Arquitecturas serverless, containerizadas o híbridas en AWS con observabilidad, rollback y un presupuesto de rendimiento.',
  },
  {
    title: 'Transferencia de conocimiento',
    body: 'Cada proyecto se entrega con documentación, registros de decisiones arquitectónicas y una guía que tus propios ingenieros pueden extender.',
  },
];

const FAQ_ITEMS = [
  {
    q: '¿Cuánto cuesta el desarrollo de software a medida?',
    a: 'Nuestros proyectos de software a medida comienzan desde $2,500+ dependiendo del alcance, integraciones y complejidad técnica. Cada proyecto recibe un presupuesto detallado por adelantado.',
  },
  {
    q: '¿Cuánto tarda construir software a medida?',
    a: 'La mayoría de las plataformas a medida toman de 2 a 6 meses, entregadas en sprints estructurados para que veas progreso medible cada 2-4 semanas.',
  },
  {
    q: '¿Cuál es la diferencia entre software a medida y herramientas comerciales?',
    a: 'Las herramientas comerciales obligan a tu equipo a adaptarse al software. El software a medida se adapta a tus flujos reales, eliminando fricción y mejorando la productividad desde el primer día.',
  },
];
---

<Layout
  locale="es"
  title="Desarrollo de Software a Medida para Negocios en Crecimiento | Horizon.gh"
  description="Soluciones de software a medida adaptadas a tus operaciones. Plataformas SaaS, herramientas internas, APIs, dashboards y automatización - diseñadas para escalar con tu negocio."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-gray-200">
      <HeroCircuitBackdrop />
      <div class="shell relative flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
        <p class="label-sm inline-block rounded-full border-2 border-[var(--color-accent-cyan)] px-4 py-1.5 text-[var(--color-accent-cyan)]">
          Desarrollo de Software a Medida
        </p>
        <h1 class="display-xl mt-8 max-w-5xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl">
          Software construido <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">alrededor de ti</span>
        </h1>
        <p class="body-lg mx-auto mt-8 max-w-xl text-gray-600">
          Plataformas personalizadas, herramientas internas y productos SaaS diseñados para ajustarse a tu realidad operativa &mdash; no a la hoja de ruta de un proveedor.
        </p>
        <a
          href="/es/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Discute tu proyecto
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Our Approach -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="approach-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="approach-heading" class="display-lg text-gray-900 max-w-lg">
            Nuestro <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">enfoque</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            No vendemos software genérico. Diseñamos sistemas que coinciden con cómo tu equipo realmente trabaja.
          </p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {FEATURES.map((feature) => (
            <article class="group rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)]">
              <h3 class="text-xl font-display font-bold">{feature.title}</h3>
              <p class="mt-4 text-gray-600">{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-b border-gray-200 py-20" aria-labelledby="csw-faq-heading">
      <div class="shell mx-auto max-w-3xl px-6">
        <h2 id="csw-faq-heading" class="display-lg text-gray-900 text-center">
          Preguntas <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">frecuentes</span>
        </h2>
        <div class="mt-14 space-y-4">
          {FAQ_ITEMS.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
        <p class="mt-12 text-center text-gray-600">
          ¿Necesitas más detalles?{' '}
          <a href="/es/faq" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            Ver todas las FAQ
          </a>{' '}
          o{' '}
          <a href="/es/services" class="font-bold text-[var(--color-accent-cyan)] underline underline-offset-4 hover:no-underline">
            explora nuestros servicios
          </a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gray-50">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          ¿Listo para construir tu <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">sistema?</span>
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Cuéntanos qué necesitas. Enviaremos un documento de alcance en un día hábil &mdash; sin compromiso.
        </p>
        <a
          href="/es/contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Inicia la conversación
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>