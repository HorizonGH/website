---
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import HeroCircuitBackdrop from '../../components/HeroCircuitBackdrop.astro';
const t = useTranslations('es') as any;

const SERVICES = [
  {
    title: t.services.web_dev.title,
    subtitle: t.services.web_dev.subtitle,
    body: t.services.web_dev.description,
    metric: t.services.web_dev.metric,
  },
  {
    title: t.services.software_dev.title,
    subtitle: t.services.software_dev.subtitle,
    body: t.services.software_dev.description,
    metric: t.services.software_dev.metric,
  },
  {
    title: t.services.digital_transform.title,
    subtitle: t.services.digital_transform.subtitle,
    body: t.services.digital_transform.description,
    metric: t.services.digital_transform.metric,
  },
];

const PROCESS = [
  {
    step: "01",
    title: t.framework.step1_title,
    body: "Mapeamos el terreno: sistemas actuales, restricciones, tráfico y el resultado que realmente importa. Sales con una tesis técnica por escrito.",
  },
  {
    step: "02",
    title: t.framework.step2_title,
    body: "Diseño e ingeniería avanzan juntos. Interfaz, modelo de datos e infraestructura se deciden en la misma sala, no se pasan por encima de un muro.",
  },
  {
    step: "03",
    title: t.framework.step3_title,
    body: "Lanzamos con instrumentación. Cada release lleva monitoreo, rollback y un presupuesto de rendimiento que puedes exigirnos.",
  },
];

const WORKS = [
  {
    client: "HorizonFood",
    tag: "Sistema ERP",
    title: "Gestión de inventarios para restaurantes",
    body: "Un sistema ERP completo para restaurantes, gestionando ingredientes, niveles de stock y seguimiento operativo en tiempo real en múltiples ubicaciones.",
    result: "30% menos desperdicio de alimentos",
    featured: true,
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1785617753/Screenshot_2026-08-01_165533_mtuvjx.png",
  },
  {
    client: "Azure Marine",
    tag: t.portfolio.proj3_cat,
    title: "Gestión de reservas y flota",
    body: "Un motor de disponibilidad y un sitio editorial para una flota de charter, reemplazando hojas de cálculo y reservas telefónicas.",
    result: "38% más reservas directas",
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1776224245/Screenshot_2026-04-14_233508_motvm1.jpg",
  },
  {
    client: "Oasis Logistic",
    tag: t.portfolio.proj4_cat,
    title: "Columna vertebral de seguimiento de envíos",
    body: "Seguimiento impulsado por eventos entre transportistas, visible a través de una línea de tiempo única para el cliente y una vista de operaciones interna.",
    result: "12 integraciones de transportistas",
    image: "https://res.cloudinary.com/dnta7zbad/image/upload/v1776224244/Screenshot_2026-04-14_233436_dyhlu8.jpg",
  },
];

const TESTIMONIALS = [
  {
    quote: t.home_page.testimonial1_quote,
    name: t.testimonials.t1_name,
    role: t.testimonials.t1_role,
    avatar: "Jhon+M",
  },
  {
    quote: t.home_page.testimonial2_quote,
    name: t.testimonials.t2_name,
    role: t.testimonials.t2_role,
    avatar: "Sarah+A",
  },
  {
    quote: t.home_page.testimonial3_quote,
    name: t.testimonials.t3_name,
    role: t.testimonials.t3_role,
    avatar: "David+O",
  },
];
---

<Layout locale="es" title={t.seo.home_title} description={t.seo.home_desc}>
  <!-- Add Cursive Font for the signatures -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet" />

  <div class="bg-surface text-gray-900 font-sans">
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-gray-200">
      <HeroCircuitBackdrop />
      <div class="shell relative flex min-h-[78vh] flex-col items-center justify-center py-24 text-center">
        <p class="label-sm text-gray-500">Ingeniería desde América</p>
        <h1 class="display-xl mt-6 max-w-4xl font-display text-5xl font-black uppercase tracking-[-0.08em] leading-[0.9] sm:text-6xl md:text-7xl lg:text-[5.8rem]">
          {t.hero.title_part1} EL <span class="text-accent-cyan drop-shadow-[0_0_16px_rgba(76,214,251,0.45)]">{t.hero.title_part2}</span> {t.hero.title_part3}
        </h1>
        <p class="body-lg mt-8 max-w-xl text-gray-600">
          Desarrollo de software a medida y plataformas web para negocios en crecimiento
          — desde herramientas internas hasta infraestructura digital construida alrededor
          de cómo operas realmente.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#contact"
            class="group inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)] hover:-translate-y-0.5"
          >
            {t.hero.cta}
            <svg class="ml-2 h-5 w-5 transition-transform group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </a>
          <a
            href="/es/services"
            class="inline-flex items-center gap-2 border-b-2 border-gray-900 pb-1 text-base font-bold transition-colors hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)]"
          >
            Mira lo que construimos
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="border-b border-gray-200 bg-white py-20 sm:py-24">
      <div class="shell mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-gray-900 leading-tight mb-6">
          Desarrollo de software a medida y plataformas web para negocios en crecimiento
        </h2>
        <p class="body-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Horizon diseña y construye software a medida, plataformas web, herramientas
          internas e infraestructura digital para negocios que necesitan tecnología
          construida alrededor de la forma en que realmente operan.
        </p>
      </div>
    </section>

    <!-- Services Section -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="services-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="services-heading" class="display-lg text-gray-900 max-w-lg">
            Nuestros <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">servicios</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Tres prácticas, un mismo estándar de ingeniería. La mayoría de los proyectos
            comienzan con una y crecen hacia las demás.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {SERVICES.map((service) => (
            <article
              key={service.title}
              class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:border-[var(--color-accent-cyan)] hover:shadow-[0_24px_40px_-24px_rgba(76,214,251,0.5)]"
            >
              <p class="label-sm text-[var(--color-accent-cyan)] mb-2">{service.subtitle}</p>
              <h3 class="text-2xl font-display font-bold">{service.title}</h3>
              <p class="mt-4 flex-1 text-gray-600">{service.body}</p>
              <p class="label-sm mt-8 text-[var(--color-accent-cyan)]">{service.metric}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="process-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 class="display-lg text-gray-900">
          El <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">marco de trabajo</span>
        </h2>
        <ol class="mt-14 grid gap-10 md:grid-cols-3">
          {PROCESS.map((phase) => (
            <li key={phase.step} class="border-t-2 border-gray-900 pt-6">
              <span class="font-display text-5xl font-black text-[var(--color-accent-cyan)]">{phase.step}</span>
              <h3 class="mt-4 text-xl font-display font-bold">{phase.title}</h3>
              <p class="mt-3 text-gray-600">{phase.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Portfolio / Selected Works Section -->
    <section class="border-b border-gray-200 bg-gray-50 py-24" aria-labelledby="work-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <h2 id="work-heading" class="display-lg text-gray-900">
            Proyectos <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">destacados</span>
          </h2>
          <p class="body-md max-w-sm text-gray-600">
            Trabajos representativos. Estudios de caso detallados disponibles a petición.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {WORKS.map((item) => (
            <article
              key={item.client}
              class={`group relative flex flex-col rounded-2xl overflow-hidden border border-gray-200 bg-cover bg-center transition-all hover:border-[var(--color-accent-cyan)]/60 ${
                item.featured ? "md:col-span-2" : ""
              }`}
              style={`background-image: url('${item.image}');`}
            >
              <div class="absolute inset-0 bg-gradient-to-t from-[#000]/90 via-[#000]/40 to-transparent z-10"></div>
              <div class="relative z-20 flex flex-col p-8 min-h-[320px] justify-end">
                <div class="flex items-center gap-3">
                  <span class="label-sm text-[var(--color-accent-cyan)]">{item.client}</span>
                  <span class="text-xs text-[#ffffff]/40">{item.tag}</span>
                </div>
                <h3 class="mt-4 text-2xl md:text-3xl font-display font-bold text-[#ffffff]">{item.title}</h3>
                <p class="mt-3 max-w-xl text-[#ffffff]/60">{item.body}</p>
                <p class="mt-6 font-display text-lg font-bold text-[var(--color-accent-cyan)]">{item.result}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="border-b border-gray-200 bg-white py-24" aria-labelledby="testimonials-heading">
      <div class="shell mx-auto max-w-7xl px-6">
        <h2 class="display-lg text-gray-900">
          Perspectivas de <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">clientes</span>
        </h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {TESTIMONIALS.map((item) => (
            <figure
              key={item.name}
              class="flex flex-col rounded-2xl border border-[#1f2937] bg-[#111827] p-8 shadow-xl"
            >
              <blockquote class="flex-1 text-lg leading-relaxed text-[#f3f4f6]">
                &ldquo;{item.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-8 border-t border-[#1f2937] pt-5 flex items-center gap-4">
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-[var(--color-accent-cyan)] flex-shrink-0">
                  <img
                    src={`https://ui-avatars.com/api/?name=${item.avatar}&background=4CD6FB&color=000`}
                    alt={item.name}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <span class="block font-bold text-[#ffffff]">{item.name}</span>
                  <span class="text-sm text-[#9ca3af]">{item.role}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Ready to Build CTA Section -->
    <section class="py-24 border-b border-gray-200 bg-white">
      <div class="shell mx-auto max-w-7xl px-6 text-center">
        <h2 class="display-lg text-gray-900">
          ¿Listo para <span class="font-['Caveat'] text-[var(--color-accent-cyan)] text-5xl md:text-6xl">construir?</span>
        </h2>
        <p class="body-lg mx-auto mt-6 max-w-lg text-gray-600">
          Cuéntanos qué intentas lanzar. Responderemos en un día hábil con un punto de
          vista, no con un folleto.
        </p>
        <a
          href="#contact"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-cyan)] px-7 py-3.5 text-base font-bold text-black transition-shadow hover:shadow-[0_0_24px_rgba(76,214,251,0.55)]"
        >
          Inicia la conversación
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>